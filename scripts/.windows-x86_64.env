# Platform env for windows-x86_64.
# Sourced by scripts/env.sh after .common.env.
# MIRRORCLONE_BIN is resolved by env.sh to the newest
# tools/mirror-clone/v*/windows-x86_64/mirror-clone.exe (fallback: mirror-clone on PATH).

RECIPE_SERVER_PLATFORM="windows-x86_64"

MIRRORCLONE_BIN="${MIRRORCLONE_VERSION_DIR}/${RECIPE_SERVER_PLATFORM}/mirror-clone.exe"
