# Platform env for windows-arm64.
# Sourced by scripts/env.sh after .common.env.
# The mirror-clone bundle has no windows-arm64 build (upstream ships
# windows-amd64 only); env.sh falls back to mirror-clone on PATH.

RECIPE_SERVER_PLATFORM="windows-arm64"

MIRRORCLONE_BIN="${MIRRORCLONE_VERSION_DIR}/${RECIPE_SERVER_PLATFORM}/mirror-clone.exe"
