# Platform env for macos-arm64.
# Sourced by scripts/env.sh after .common.env.
# MIRRORCLONE_BIN is resolved by env.sh to the newest
# tools/mirror-clone/v*/macos-arm64/mirror-clone (fallback: mirror-clone on PATH).

RECIPE_SERVER_PLATFORM="macos-arm64"

MIRRORCLONE_BIN="${MIRRORCLONE_VERSION_DIR}/${RECIPE_SERVER_PLATFORM}/mirror-clone"
