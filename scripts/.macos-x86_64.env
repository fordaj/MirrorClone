# Platform env for macos-x86_64.
# Sourced by scripts/env.sh after .common.env.
# MIRRORCLONE_BIN is resolved by env.sh to the newest
# tools/mirror-clone/v*/macos-x86_64/mirror-clone (fallback: mirror-clone on PATH).
# SEVENZZ_BIN points to the 7zz binary for macOS.

RECIPE_SERVER_PLATFORM="macos-x86_64"

MIRRORCLONE_BIN="${MIRRORCLONE_VERSION_DIR}/${RECIPE_SERVER_PLATFORM}/mirror-clone"
SEVENZZ_BIN="${SEVENZIP_VERSION_DIR}/mac-x64/7zz"
