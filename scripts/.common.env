# scripts/.common.env — base environment for mirror-clone.
#
# Sourced by scripts/env.sh before the platform-specific env
# (.<platform>.env, e.g. .macos-x86_64.env). Platform-independent
# variables live here; OS/arch specifics live there.

TOOLS_DIR="tools"

MIRRORCLONE_REPO="fordaj/mirror-clone"
MIRRORCLONE_TAG_PATTERN="v[0-9]*"
MIRRORCLONE_DIR="${TOOLS_DIR}/mirror-clone"
MIRRORCLONE_VERSION_DIR="${MIRRORCLONE_DIR}/v0.1.0"

SEVENZIP_DIR="${TOOLS_DIR}/7zip"
SEVENZIP_VERSION_DIR="${SEVENZIP_DIR}/v26.06"
